<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity"
    android:orientation="vertical"
    android:gravity="center">

    <!-- ユーザー情報エリア -->
    <LinearLayout
        android:id="@+id/userInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- ユーザーアイコン -->
        <ImageView
            android:id="@+id/userIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/icon1"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:contentDescription="ユーザーアイコン"
            android:layout_marginEnd="12dp"/>

        <!-- ユーザーネーム+ボタンを縦並び -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ユーザーネーム -->
            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ユーザーネーム"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>

            <!-- プロフィール編集ボタン（下に配置） -->
            <Button
                android:id="@+id/editProfileBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ポイントを交換"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChart"
        android:layout_width="match_parent"
        android:layout_height="300dp"/>


    <!--<TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="学習記録"
        android:textSize="40sp"
        android:includeFontPadding="false"/>
    -->

    <TextView
        android:id="@+id/totalScoreLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/result_total_score"
        android:textSize="25sp"
        android:layout_marginTop="30dp"
        android:includeFontPadding="false"/>


    <TextView
        android:id="@+id/totalScoreSecurityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/result_total_score_security"
        android:textSize="20sp"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/totalScoreDigimanLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/result_total_score_digiman"
        android:textSize="20sp"
        android:layout_marginTop="5dp"
        android:includeFontPadding="false"/>

    <TextView
        android:id="@+id/totalScoreHowquizLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/result_total_score_howquiz"
        android:textSize="20sp"
        android:layout_marginTop="5dp"
        android:includeFontPadding="false"/>

    <Button
        android:id="@+id/returnBtn"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/teal_700"
        android:scrollbarTrackHorizontal="@color/teal_700"
        android:text="@string/btn_return"
        android:textColor="@color/white"
        app:backgroundTint="@null"
        android:includeFontPadding="false"/>

    <Button
        android:id="@+id/resetBtn"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/teal_700"
        android:scrollbarTrackHorizontal="@color/teal_700"
        android:textColor="@color/white"
        app:backgroundTint="@null"
        android:text="今までの記録のリセット"
        android:includeFontPadding="false"/>

</LinearLayout>